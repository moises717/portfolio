---
import { skills } from '@/data/skill.ts';
import Section from '@/components/Section.astro';
import SkillSection from '@/components/SkillSection.astro';
import { getI18N } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const skillList = Object.entries(skills).map(([section, list]) => ({ section, list }));
---

<Section title={i18n.SKILLS.TITLE} id='skills'>
	<div class='grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5'>
		{skillList.map(({ section, list }) => <SkillSection section={section} list={list} />)}
	</div>
</Section>
