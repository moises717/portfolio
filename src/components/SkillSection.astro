---
import { type Skill } from '../data/skill';
import SkillBadge from './SkillBadge.astro';
import { getI18N } from '@/i18n/index';

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

interface Props {
	section: string;
	list: Skill[];
}
const { section, list } = Astro.props;
const sectionKey = section.toLowerCase();
const title18n = i18n.SKILLS[sectionKey as keyof typeof i18n.SKILLS] ?? section;
---

<div class='flex flex-col rounded-2xl p-4 sm:p-5 md:p-6 bg-white/60 dark:bg-neutral-900/40 border border-neutral-200/60 dark:border-neutral-800/60 backdrop-blur-xs shadow-[0_1px_3px_0_rgba(0,0,0,0.02)] dark:shadow-[0_1px_3px_0_rgba(0,0,0,0.2)] transition-all duration-300 hover:shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] dark:hover:shadow-[0_4px_20px_-4px_rgba(0,0,0,0.35)] hover:border-neutral-300/80 dark:hover:border-neutral-700/80'>
	<!-- Category Header with contextual icon and count -->
	<div class='flex items-center justify-between pb-3.5 mb-3.5 border-b border-neutral-100 dark:border-neutral-800/60'>
		<div class='flex items-center gap-2.5'>
			{sectionKey === 'ai' && (
				<svg class='size-4.5 text-violet-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<path d='m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z' />
					<path d='M5 3v4M3 5h4M19 17v4M17 19h4' />
				</svg>
			)}
			{sectionKey === 'backend' && (
				<svg class='size-4.5 text-indigo-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<rect width='20' height='8' x='2' y='2' rx='2' />
					<rect width='20' height='8' x='2' y='14' rx='2' />
					<line x1='6' x2='6.01' y1='6' y2='6' />
					<line x1='6' x2='6.01' y1='18' y2='18' />
				</svg>
			)}
			{sectionKey === 'frontend' && (
				<svg class='size-4.5 text-cyan-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<rect width='18' height='18' x='3' y='3' rx='2' />
					<path d='M3 9h18M9 21V9' />
				</svg>
			)}
			{sectionKey === 'cloud' && (
				<svg class='size-4.5 text-sky-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<path d='M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z' />
				</svg>
			)}
			{sectionKey === 'databases' && (
				<svg class='size-4.5 text-emerald-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<ellipse cx='12' cy='5' rx='9' ry='3' />
					<path d='M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5' />
					<path d='M3 12c0 1.66 4 3 9 3s9-1.34 9-3' />
				</svg>
			)}
			{sectionKey === 'learning' && (
				<svg class='size-4.5 text-amber-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<path d='m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z' />
				</svg>
			)}
			{sectionKey === 'otros' && (
				<svg class='size-4.5 text-purple-500 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
					<path d='M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83' />
				</svg>
			)}
			<h3 class='text-sm sm:text-base font-bold text-gray-900 dark:text-white tracking-tight'>
				{title18n}
			</h3>
		</div>
		<span class='text-[11px] font-semibold text-neutral-400 dark:text-neutral-500 px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800/60 border border-neutral-200/50 dark:border-neutral-700/50 tabular-nums'>
			{list.length}
		</span>
	</div>

	<!-- Badges List -->
	<div class='flex flex-wrap gap-2'>
		{list.map(skill => <SkillBadge {...skill} />)}
	</div>
</div>
