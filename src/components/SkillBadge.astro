---
import { cn } from '@/utils/cn';
import TechIcon from './TechIcon.astro';

interface Props {
	name: string;
	icon: string;
	className?: string;
}

const { name, icon, className } = Astro.props;
---

<div
	class={cn(
		'group inline-flex items-center gap-2 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm font-medium bg-neutral-100/70 dark:bg-neutral-800/40 text-neutral-800 dark:text-neutral-200 border border-neutral-200/50 dark:border-neutral-800/60 shadow-[0_1px_2px_rgba(0,0,0,0.02)] transition-all duration-200 hover:scale-[1.02] hover:bg-white dark:hover:bg-neutral-800/80 hover:border-indigo-400/50 dark:hover:border-indigo-500/50 hover:shadow-xs select-none cursor-default',
		className,
	)}
>
	<TechIcon name={name} icon={icon} class='size-4 sm:size-4.5 shrink-0 transition-transform duration-200 group-hover:scale-110' />
	<span class='leading-none'>{name}</span>
</div>
